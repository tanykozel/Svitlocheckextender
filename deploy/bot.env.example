# Secrets for the bot (root-only file). Same values as the GitHub repository secrets.
TELEGRAM_BOT_TOKEN=
SVITLO_STATE_KEY=
# Optional: the owner's chat id (same as the TELEGRAM_CHAT_ID secret)
TELEGRAM_CHAT_ID=
# Optional: an uptime check URL (e.g. https://hc-ping.com/<uuid>); you get an email if pings stop
SVITLO_HEALTHCHECK_URL=
